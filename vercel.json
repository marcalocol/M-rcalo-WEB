{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/contrato-de-servicios", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }] }
  ],
  "redirects": [
    { "source": "/buscador.html", "destination": "/busqueda-de-marca-express", "permanent": true },
    { "source": "/buscador", "destination": "/busqueda-de-marca-express", "permanent": true },
    { "source": "/camara-de-comercio.html", "destination": "/registro-de-marca-colombia#camara-de-comercio", "permanent": true },
    { "source": "/camara-de-comercio", "destination": "/registro-de-marca-colombia#camara-de-comercio", "permanent": true }
  ]
}
